NODE_ENV=development
PORT=5000
TRUST_PROXY=false

# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_NAME=ubwiwacu_honey
DB_USER=postgres
DB_PASSWORD=your_db_password
DB_SSL=false
DB_POOL_MAX=10

# JWT
JWT_SECRET=replace_with_a_long_random_string
JWT_EXPIRES_IN=8h

# Admin seed (used only by scripts/seed.js)
ADMIN_NAME=Administrator
ADMIN_EMAIL=admin@ubwiwacu.com
ADMIN_PASSWORD=ChangeMe123!

# Business contact (required)
BUSINESS_NAME=Ubw'iwacu Honey
BUSINESS_PARENT=IBAKWE Business Group
BUSINESS_EMAIL=ubwiwacuhoney250@gmail.com
BUSINESS_PHONE=+250780737320
BUSINESS_WHATSAPP=+250780737320

# Payment instructions shown to customers (leave empty until the business provides official details)
PAYMENT_INSTRUCTIONS=

# Storage
RECEIPT_STORAGE=./storage/receipts
UPLOAD_STORAGE=./storage/uploads/products
MAX_UPLOAD_MB=5

# Email (Gmail App Password). Leave EMAIL_PASS empty to disable sending.
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=ubwiwacuhoney250@gmail.com
EMAIL_PASS=
EMAIL_FROM=Ubw'iwacu Honey <ubwiwacuhoney250@gmail.com>

# CORS (comma separated)
CLIENT_URL=http://localhost:5173,http://localhost:3000

# Rate limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_LOGIN_MAX=5
RATE_LIMIT_CHECKOUT_MAX=20
RATE_LIMIT_PAYMENT_MAX=10

# Receipt email retry (0 disables)
RECEIPT_RETRY_INTERVAL_MS=900000

# Payment gateway stub
GATEWAY_ENABLED=false
GATEWAY_WEBHOOK_SECRET=replace_with_gateway_secret

# Mobile money push (customer approves on their phone with their PIN)
# MOMO_PROVIDER: mock (development: auto-approves after ~12 s; numbers ending 0000 are declined)
#                intouch (IntouchPay: MTN + Airtel Rwanda) | empty = off (reference flow only)
MOMO_PROVIDER=
# Public URL the provider calls back, e.g. https://api.yourdomain.rw/api/webhooks/momo
MOMO_CALLBACK_URL=
# IntouchPay credentials (from the Intouch team)
INTOUCH_BASE_URL=https://www.intouchpay.co.rw/api
INTOUCH_USERNAME=
INTOUCH_ACCOUNT_NO=
INTOUCH_PARTNER_PASSWORD=
